<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:BetterDAM.UI.Converters"
             xmlns:controls="using:BetterDAM.UI.Controls"
             xmlns:svc="using:BetterDAM.UI.Services"
             x:Class="BetterDAM.UI.App"
             Name="BetterDAM"
             RequestedThemeVariant="Dark">

  <!--
    Application-scoped menu. On macOS these items land in the application menu, next to Quit, which
    is where the platform expects Settings to be. Other platforms have no such menu, so this is
    ignored there and File carries Settings instead - see MenuConventions.
  -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="Settings…"
                      Gesture="{x:Static svc:MenuConventions.Settings}"
                      Click="OnOpenSettings" />
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Resources>

    <!--
      The themed surfaces. Defined here so the keys always resolve — including in the designer, and
      during the moment before AppThemes.Apply runs at startup — and replaced wholesale at runtime
      when the theme changes. These values are Darkroom; see AppThemes for what each one paints.
    -->
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="#000000" />
    <SolidColorBrush x:Key="AppPanelBrush" Color="#101010" />

    <conv:MediaTypeGlyphConverter x:Key="MediaTypeGlyph" />
    <conv:StarGlyphConverter x:Key="StarGlyph" />
    <conv:StatusBrushConverter x:Key="StatusBrush" />
    <conv:PlayGlyphConverter x:Key="PlayGlyph" />
    <conv:VolumeGlyphConverter x:Key="VolumeGlyph" />
    <conv:SourceBadgeBrushConverter x:Key="SourceBadgeBrush" />
    <conv:KeywordHeadingConverter x:Key="KeywordHeading" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!--
      The application's base colour, in one place rather than on each window. A Style setter outranks
      the one in Fluent's control theme, which is what makes this take effect; a window that sets
      Background itself still wins over both, which is how the media viewer stays black.
    -->
    <Style Selector="Window">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
    </Style>

    <!--
      Selection colour is not styled here. It follows the accent, which AppThemes sets from the theme
      or leaves to the platform — see ApplyAccent for why overriding individual controls turned out
      to be the wrong lever.

      The hand-drawn ring takes its settings from resources rather than being configured at each use
      site, so the folder tree's template says only "there is a ring here" and the tuning lives in
      one place. When the experiment is off the ring is collapsed and costs nothing.
    -->
    <!--
      With the experiment on, the pencil is the only mark a row gets — for hover as well as
      selection, since a standard hover highlight that vanished the instant a hand-drawn ring
      appeared was the jarring part. Every state of the fill goes, not just the selected one, which
      is why this matches the part unqualified. The part name was read from a live visual tree
      rather than guessed: the fill sits on Border#PART_LayoutRoot, and PART_HeaderPresenter inside
      it is transparent.
    -->
    <Style Selector="TreeView.handDrawn TreeViewItem /template/ Border#PART_LayoutRoot">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="controls|RoughMark">
      <Setter Property="IsVisible" Value="{DynamicResource AppRingEnabled}" />
      <Setter Property="Roughness" Value="{DynamicResource AppRingRoughness}" />
      <Setter Property="Animates" Value="{DynamicResource AppRingAnimates}" />
      <Setter Property="Stroke" Value="{DynamicResource AppRingInk}" />
    </Style>
  </Application.Styles>

</Application>
