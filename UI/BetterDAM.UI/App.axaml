<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:BetterDAM.UI.Converters"
             x:Class="BetterDAM.UI.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <conv:MediaTypeGlyphConverter x:Key="MediaTypeGlyph" />
    <conv:StarGlyphConverter x:Key="StarGlyph" />
    <conv:StatusBrushConverter x:Key="StatusBrush" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
